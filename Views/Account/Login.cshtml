@{
    ViewData["Title"] = "Вход";
}

<h2>Вход</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form method="post">

    <div class="mb-3">
        <label>login</label>
        <input type="text" name="login" class="form-control" />
    </div>

    <div class="mb-3">
        <label>password</label>
        <input type="text" name="password" class="form-control"/>
    </div>

    <button type="submit" class="btn-success">
        Войти
    </button>

</form>