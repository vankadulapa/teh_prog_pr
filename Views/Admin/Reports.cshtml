@{
    ViewData["Title"] = "Отчёты";
}

<h1>Отчёты</h1>

<div class="row">

    <div class="col-md-4">
        <div class="card p-3">
            <h3>Товары</h3>
            <h2>@ViewBag.Products</h2>
        </div>
    </div>


    <div class="col-md-4">
        <div class="card p-3">
            <h3>Пользователи</h3>
            <h2>@ViewBag.Users</h2>
        </div>
    </div>


    <div class="col-md-4">
        <div class="card p-3">
            <h3>Заказы</h3>
            <h2>@ViewBag.Orders</h2>
        </div>
    </div>

</div>