@model IEnumerable<pr4.Models.Product>

@{
    ViewData["Title"] = "Каталог товаров";
}

<h2>Каталог товаров</h2>

<form method="get">

    <input type="text"
        name="searchString"
        placeholder="Поиск товара..."
        class="form-control" />

        <br />

        <button type="submit" class="btn btn-primary">
            Найти
        </button>

</form>

<br />

@if (Model == null || !Model.Any())
{
    <p>Товаров нет.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Название</th>
                <th>Категория</th>
                <th>Бренд</th>
                <th>Цена</th>
                <th>Количество</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@(item.Category?.CategoryName ?? "-")</td>
                    <td>@(item.Brand?.BrandName ?? "-")</td>
                    <td>@item.Price</td>
                    <td>@item.InStock</td>
                </tr>
            }
        </tbody>
    </table>
}